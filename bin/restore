#!/bin/bash
set -euo pipefail

REPO_DIR=$(pwd)
TARGET="${HOME}"

mkdir -p "${TARGET}"

files_or_directories_to_restore=(
    ".tmux.conf"
    ".vimrc"
    ".bashrc"
    ".profile"
    ".inputrc"
    ".npmrc"
    ".vimrc_background"
    ".gitconfig"
    ".gitignore"
    ".gitignore_global"
    ".rgignore"
    ".ctags"
    ".yabairc"
    ".skhdrc"
    ".vim"
)

for file_or_directory in "${files_or_directories_to_restore[@]}"; do
    path="${REPO_DIR}/${file_or_directory}"

    if [ -d "$path" ]; then
        rsync -a "${path}" "${TARGET}"
        continue
    fi

    if [ -s "$path" ]; then
        cp "${path}" "${TARGET}"
    fi
done

# Claude Code global config — claude/ (no dot, see claude/README.md) maps onto ~/.claude
rsync -a --exclude README.md "${REPO_DIR}/claude/" "${TARGET}/.claude/"
