#!/bin/bash
set -euo pipefail

cur_dir=$(pwd)

rsync -a --exclude "bundle" --exclude "undo" ~/.vim "${cur_dir}"

files_to_copy=(
    "${HOME}/.tmux.conf"
    "${HOME}/.vimrc"
    "${HOME}/.bashrc"
    "${HOME}/.profile"
    "${HOME}/.inputrc"
    "${HOME}/.npmrc"
    "${HOME}/.vimrc_background"
    "${HOME}/.gitconfig"
    "${HOME}/.gitignore"
    "${HOME}/.gitignore_global"
    "${HOME}/.rgignore"
    "${HOME}/.ctags"
    "${HOME}/.bash_config"
)

for file in "${files_to_copy[@]}"; do
    [ -s "$file" ] && cp "${file}" "${cur_dir}"
done

xdg_config_files=(
    "karabiner/karabiner.json"
    "ccstatusline/settings.json"
)

for rel in "${xdg_config_files[@]}"; do
    src="${HOME}/.config/${rel}"
    if [ -f "$src" ]; then
        mkdir -p "${cur_dir}/.config/$(dirname "$rel")" \
            && cp "$src" "${cur_dir}/.config/${rel}"
    fi
done

rtorrentrc_path="/tmp/thelad.io/rutorrent/config/rtorrent/rtorrent.rc"
if [ -f "$rtorrentrc_path" ]; then
    mkdir -p "${cur_dir}/rtorrent" \
        && cp "${rtorrentrc_path}" "${cur_dir}/rtorrent/"
fi

# Claude Code global config — refresh only files already tracked in claude/ (see claude/README.md)
(cd "${cur_dir}/claude" && find . -type f ! -name README.md) | while read -r rel; do
    src="${HOME}/.claude/${rel#./}"
    if [ -f "$src" ]; then
        cp "$src" "${cur_dir}/claude/${rel#./}"
    fi
done
