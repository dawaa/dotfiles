{
  "model": "claude-fable-5[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jandro/.claude/hooks/claude-code-honcho-capture.sh"
          },
          {
            "type": "command",
            "command": "/Users/jandro/.claude/hooks/claude-code-honcho-enrich.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/jandro/.claude/hooks/no-overwrite-vault.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "/private/tmp"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws"
      ]
    }
  },
  "effortLevel": "high",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
